def canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()


def digest(value: Any) -> str:
    return hashlib.sha256(canonical(value)).hexdigest()


def file_sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def verify_runtime_bytes(path: Path) -> list[str]:
    failures: list[str] = []
    manifest = json.loads(path.read_text())
    for name, record in manifest["distributions"].items():
        distribution = importlib.metadata.distribution(name)
        if distribution.version != record["version"]:
            failures.append(f"runtime:{name}:version")
        record_path = Path(distribution.locate_file(record["record_path"]))
        if file_sha256(record_path) != record["record_sha256"]:
            failures.append(f"runtime:{name}:RECORD")
        for source in record["whole_package_python_sources"]:
            source_path = Path(distribution.locate_file(source["path"]))
            if not source_path.is_file() or file_sha256(source_path) != source["sha256"]:
                failures.append(f"runtime:{name}:{source['path']}")
    return failures


def root_for(pointer: str) -> str:
    matches = [root for root in ROOT_ENTRYPOINTS if pointer == root or pointer.startswith(f"{root}/")]
    if not matches:
        raise ValueError(f"unbound pointer: {pointer}")
    return max(matches, key=len)


def case_key(pointer: str) -> str:
    return pointer.strip("/").replace("/", "_").replace("-", "_")


def selection_units(document: Json) -> list[tuple[str, Any]]:
    units: list[tuple[str, Any]] = []
    for selected in document["accepted_v12"]["selection"]:
        pointer, value = selected["pointer"], selected["value"]
        if isinstance(value, dict):
            units.extend((f"{pointer}/{key}", value[key]) for key in sorted(value))
        elif isinstance(value, list):
            units.extend((f"{pointer}/{index}", value[index]) for index in range(len(value)))
        else:
            units.append((pointer, value))
    return units


def driver_catalog() -> Json:
    catalog: Json = {}
    for root, entrypoint in ROOT_ENTRYPOINTS.items():
        all_units_projection = entrypoint.startswith("projection:") or root in {
            "/terminal_arbiter/event_union",
            "/service_epoch/startup_failure_points",
        }
        mixed = root in {
            "/client_transport",
            "/cookie_contract",
            "/header_validation",
            "/pinned_source",
            "/repository_contract",
            "/response_sanitization_and_logging",
            "/sse_contract",
        }
        catalog[root] = {
            "classification": "projection" if all_units_projection else "mixed" if mixed else "behavior",
            "source_entrypoint": entrypoint,
            "stimulus_owner": "contract projection verifier" if all_units_projection else "tests.nvidia_routing.v15_fixtures:semantic_scenario_for",
            "dependency_owner": "none" if all_units_projection else "tests.nvidia_routing.v15_fixtures:dependencies_for_entrypoint",
            "extraction_owner": "contract pointer equality" if all_units_projection else "tests.nvidia_routing.v15_fixtures:extract_typed_observation",
            "contract_artifact_imports_in_behavior": 0,
        }
    return catalog


