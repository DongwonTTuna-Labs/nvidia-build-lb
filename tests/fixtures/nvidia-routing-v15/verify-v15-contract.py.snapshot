        "/service_epoch/epoch": "test_service_epoch_startup.py",
        "/service_epoch/monitor": "test_service_epoch_monitor.py",
        "/service_epoch/startup_order": "test_service_epoch_startup.py",
        "/service_epoch/startup_failure_points": "test_service_epoch_startup_failures.py",
    }
    return names[root]


PRE_COMMIT_HOOKS = (
    "before_ack_send",
    "before_ack_receive",
    "after_ack_send",
    "after_ack_receive",
    "before_ack_observed_send",
    "after_ack_observed_send",
    "before_ack_observed_receive",
    "after_ack_observed_receive",
    "accepted_at_release_linearization",
)
CONTINUE_HOOKS = (
    "immediately_after_release_linearization",
    "before_continue_send",
    "after_continue_send",
    "before_continue_receive",
    "after_continue_receive",
    "before_release_observed_send_continue",
    "after_release_observed_send_continue",
    "before_release_observed_receive_continue",
    "after_release_observed_receive_continue",
)
STOP_HOOKS = (
    "before_stop_send",
    "after_stop_send",
    "before_stop_receive",
    "after_stop_receive",
    "before_release_observed_send_stop",
    "after_release_observed_send_stop",
    "before_release_observed_receive_stop",
    "after_release_observed_receive_stop",
)


def release_declarations() -> Json:
    return {
        "generation_key": "(lease_id,frame_seq,generation)",
        "channels": {name: {"capacity": 0} for name in ("ack_observed", "ack_or_nack", "continue_or_stop", "frame", "release_observed")},
        "priority": list(PRIORITY),
        "single_linearization_point": {
            "acceptance_rule": "a proposal/cancellation whose coordinator acceptance sequence is <= release_commit cutoff belongs to g and forces Stop(g); a later acceptance belongs only to g+1",
            "continue_rule": "Continue(g) is committed only when arbiter Open and current batch has no Stop proposal through the cutoff",
            "location": "inside supervisor-owned proposal coordinator lock, the single atomic write ClosedBatch(g)+ReleaseDecision(g,Continue|Stop)",
            "name": "release_commit",
            "post_rule": "after commit, Continue(g) cannot be revoked; the child observes it and performs exactly one anext invocation whose single allowed scripted boundary result is ScriptedFrame(g+1,seq+1); the late proposal is g+1",
            "stop_rule": "any accepted-through-cutoff Stop proposal commits Stop(g) and forbids anext",
        },
        "caught_cancellation_dispatch": {
            "dispatch_read": "under coordinator lock read ReleaseDecision(g) exactly once; None, Stop(g), Continue(g) are exhaustive",
            "scope": "bounded CancelScope(shield=True) named release_finalization_scope(g), outside the cancelled request-root scope and using the existing absolute control deadline",
            "pre_commit_owner": "PreCommitReleaseSurvivor(g)",
            "committed_stop_owner": "CommittedStopSurvivor(g)",
            "committed_continue_owner": "CommittedReleaseSurvivor(g)",
            "child_scope": "network_io_scope(g), owned by the selected survivor until cancel+join",
            "pre_commit_steps": ["close participant submission and drain the accepted batch", "commit ClosedBatch(g)+Stop(g) at release_commit", "send Stop(g), child receives Stop(g), send and receive ReleaseObserved(g)", "cancel network_io_scope(g), join child, prove owned_resources=0", "leave shield and re-raise the exact saved cancellation instance"],
            "committed_stop_steps": ["do not change the committed Stop(g) or its winner", "complete Stop send/receive and ReleaseObserved send/receive if not already observed", "cancel network_io_scope(g), join child, prove owned_resources=0", "leave shield and re-raise the exact saved cancellation instance"],
            "committed_continue_steps": ["do not revoke Continue(g)", "complete Continue send/receive", "child performs exactly one anext and hands exactly one ScriptedFrame(g+1,seq+1) to CommittedReleaseSurvivor(g)", "complete ReleaseObserved send/receive", "cancel network_io_scope(g), join child, prove owned_resources=0", "leave shield and re-raise the exact saved cancellation instance"],
            "unshielded_await_count_after_catch": 0,
        },
        "release_case_formula": {"source": "verify-v15-contract.py fixed hook domains and _release_counts; candidate rows are not read", "branches": {"pre_commit": 9, "committed_continue": 9, "committed_stop": 8}, "case_count": 26, "derivation": "hard-coded hook domains independently generate every timeline, decision, count, owner, trace and saved-cancellation identity"},
    }


def _release_counts(branch: str) -> Json:
    pre = branch == "pre_commit"
    cont = branch == "committed_continue"
    return {
        "ack_send": 0 if pre else 1,
        "ack_receive": 0 if pre else 1,
        "nack_send": 1 if pre else 0,
        "nack_receive": 1 if pre else 0,
        "ack_observed_send": 1,
        "ack_observed_receive": 1,
        "continue_send": 1 if cont else 0,
        "continue_receive": 1 if cont else 0,
        "stop_send": 0 if cont else 1,
        "stop_receive": 0 if cont else 1,
        "release_observed_send": 1,
        "release_observed_receive": 1,
        "anext_calls": 1 if cont else 0,
        "anext_results": 1 if cont else 0,
        "frame_handoff_send": 1 if cont else 0,
        "frame_handoff_receive": 1 if cont else 0,
        "child_cancel": 1,
        "child_join": 1,
    }


def release_rows() -> list[Json]:
    rows: list[Json] = []
    for branch, hooks in (
        ("pre_commit", PRE_COMMIT_HOOKS),
        ("committed_continue", CONTINUE_HOOKS),
        ("committed_stop", STOP_HOOKS),
    ):
        for hook in hooks:
            if branch == "pre_commit":
                timeline = [
                    {"event": "AncestorCancelled(saved_cancel)", "generation": "g", "proposal_sequence": 1, "accepted_sequence": 1, "relative_to_cutoff": "at_or_before"},
                    {"event": "release_commit", "generation": "g", "decision": "Stop", "acceptance_cutoff": 1},
                ]
                decision, release, winner, anext, owner = None, "Stop(g)", "AncestorCancelled", "none", "PreCommitReleaseSurvivor(g)"
                trace = ["submission_close", "accepted_batch_drain", "release_commit_Stop", "Stop_send", "Stop_receive", "ReleaseObserved_send", "ReleaseObserved_receive", "child_cancel", "child_join", "saved_cancel_reraise_same_instance"]
            elif branch == "committed_continue":
                timeline = [
                    {"event": "release_commit", "generation": "g", "decision": "Continue", "acceptance_cutoff": 0},
                    {"event": "AncestorCancelled(saved_cancel)", "generation": "g+1", "accepted_sequence": 1, "relative_to_cutoff": "after"},
                ]
                decision, release, winner, anext, owner = "Continue(g)", "Continue(g)", None, "ScriptedFrame(g+1,seq+1)", "CommittedReleaseSurvivor(g)"
                trace = ["Continue_send", "Continue_receive", "anext_call", "anext_result", "frame_handoff_send", "frame_handoff_receive", "ReleaseObserved_send", "ReleaseObserved_receive", "child_cancel", "child_join", "saved_cancel_reraise_same_instance"]
            else:
                timeline = [
                    {"event": "DeadlineExpired", "generation": "g", "proposal_sequence": 1, "accepted_sequence": 1, "relative_to_cutoff": "at_or_before"},
                    {"event": "release_commit", "generation": "g", "decision": "Stop", "acceptance_cutoff": 1},
                    {"event": "AncestorCancelled(saved_cancel)", "generation": "g+1", "accepted_sequence": 2, "relative_to_cutoff": "after"},
                ]
                decision, release, winner, anext, owner = "Stop(g)", "Stop(g)", "DeadlineExpired", "none", "CommittedStopSurvivor(g)"
                trace = ["Stop_send", "Stop_receive", "ReleaseObserved_send", "ReleaseObserved_receive", "child_cancel", "child_join", "saved_cancel_reraise_same_instance"]
            rows.append(
                {
                    "case_id": hook,
                    "branch": branch,
                    "decision_at_catch": decision,
                    "input_timeline": timeline,
                    "injection_hook": hook,
                    "scripted_next": "Frame(g+1,seq+1)",
                    "expected": {
                        "release_decision": release,
                        "winner": winner,
                        "anext_result": anext,
                        "counts": _release_counts(branch),
                        "surviving_owner": owner,
                        "finalization_trace": trace,
                        "saved_cancel_reraised": {"count": 1, "same_instance": True, "after_owner_join": True},
                        "owned_resources_final": 0,
                    },
                }
            )
    return rows


def release_assertions() -> list[Json]:
    assertions: list[Json] = []
    for index, row in enumerate(release_rows(), 1):
        hook = row["case_id"]
        assertions.append(
            {
                "id": f"B01R{index:03d}",
                "class": "behavior",
                "input": {"generation": "g", "injection_hook": hook, "proposal_timeline": row["input_timeline"], "decision_at_catch": row["decision_at_catch"], "saved_cancel": "exact AncestorCancelled instance", "scripted_next": row["scripted_next"]},
                "interleaving": hook,
                "operation": {"source_entrypoint": "nvidia_build_lb.terminal:ChatSupervisor.release", "invoke_count": 1, "extraction": "ReleaseReceipt including counts, owner, trace and saved cancellation identity"},
                "expected": row["expected"],
                "owner": {"collected_node_id": f"tests/nvidia_routing/test_release_linearization.py::test_release_boundary[{hook}]", "per_assertion_result_key": f"release_boundary::{hook}::canonical_receipt_equal", "required_result": "PASS"},
            }
        )
    return assertions


def reachable_pairs() -> list[list[str]]:
    reachable: list[list[str]] = []
    for first, second in combinations(PRIORITY, 2):
        for _, events, exclusive in CHECKPOINTS:
            if first not in events or second not in events:
                continue
            if any(first in group and second in group for group in exclusive):
                continue
            reachable.append([first, second])
            break
    return reachable


def pair_checkpoint(pair: list[str]) -> str:
    first, second = pair
    for checkpoint, events, exclusive in CHECKPOINTS:
        if first in events and second in events and not any(first in group and second in group for group in exclusive):
            return checkpoint
    raise ValueError(pair)


def production_rows() -> list[Json]:
    rows: list[Json] = []
    for pair in reachable_pairs():
        checkpoint = pair_checkpoint(pair)
        for order, cutoff in (("AB", "both_before"), ("BA", "both_before"), ("AB", "A_before_B_after"), ("BA", "B_before_A_after")):
            offered = pair if order == "AB" else list(reversed(pair))
            first, second = offered
            if cutoff == "both_before":
                trace = [f"hook:{first}@{checkpoint}", f"submit:{first}", f"queue_receive:{first}", f"accept:{first}:seq=1:before_cutoff", f"hook:{second}@{checkpoint}", f"submit:{second}", f"queue_receive:{second}", f"accept:{second}:seq=2:before_cutoff", "release_commit:acceptance_cutoff=2"]
                current, late = offered, None
            else:
                trace = [f"hook:{first}@{checkpoint}", f"submit:{first}", f"queue_receive:{first}", f"accept:{first}:seq=1:before_cutoff", "release_commit:acceptance_cutoff=1", f"hook:{second}@{checkpoint}", f"submit:{second}", f"queue_receive:{second}", f"accept:{second}:seq=2:after_cutoff:g+1"]
                current, late = [first], second
            winner = min(current, key=PRIORITY.index)
            case = f"{pair[0]}__{pair[1]}__{order}__{cutoff}"
            rows.append({"case_key": case, "pair": pair, "checkpoint": checkpoint, "order": order, "cutoff": cutoff, "event_trace": list(trace), "expected": {"hook_submission_queue_acceptance_trace": list(trace), "accepted_current_generation": list(current), "accepted_next_generation": [] if late is None else [late], "current_generation_winner": winner, "late_next_generation": late, "CAS_successes": 1, "closed_batch_drains": 1, "persist_count": 1, "terminal_send_max": 1, "loser_side_effects": 0, "owned_resources_final": 0}})
    return rows


def production_assertions() -> list[Json]:
    result: list[Json] = []
    for index, row in enumerate(production_rows(), 1):
        case = row["case_key"]
        result.append({"id": f"B02P{index:03d}", "class": "behavior", "input": {"pair": row["pair"], "checkpoint": row["checkpoint"], "event_trace": row["event_trace"]}, "interleaving": f"{row['order']}:{row['cutoff']}", "operation": {"source_entrypoint": "nvidia_build_lb.terminal:ChatSupervisor.coordinate", "invoke_count": 1, "extraction": "typed submission/FIFO acceptance/release receipt"}, "expected": row["expected"], "owner": {"collected_node_id": f"tests/nvidia_routing/test_terminal_coordinator.py::test_reachable_pair[{case}]", "per_assertion_result_key": f"production_pair::{case}::canonical_receipt_equal", "required_result": "PASS"}})
    return result


def abstract_rows() -> list[Json]:
    rows: list[Json] = []
    for pair in combinations(PRIORITY, 2):
        pair_list = list(pair)
        for order in ("AB", "BA"):
            offered = pair_list if order == "AB" else list(reversed(pair_list))
            winner = min(pair_list, key=PRIORITY.index)
            rows.append({"case_key": f"{pair[0]}__{pair[1]}__{order}", "pair": pair_list, "order": order, "expected": {"offered_order": offered, "canonical_winner": winner, "CAS_successes": 1, "loser_side_effects": 0, "payload_created_by": winner}})
    return rows


def abstract_assertions() -> list[Json]:
    result: list[Json] = []
    for index, row in enumerate(abstract_rows(), 1):
        case = row["case_key"]
        result.append({"id": f"B02A{index:03d}", "class": "behavior", "input": {"typed_arbiter_only": True, "pair": row["pair"], "offered_order": row["expected"]["offered_order"]}, "interleaving": row["order"], "operation": {"source_entrypoint": "nvidia_build_lb.terminal:TerminalArbiter.register_batch", "invoke_count": 1, "extraction": "immutable winner and loser side-effect receipt"}, "expected": row["expected"], "owner": {"collected_node_id": f"tests/nvidia_routing/test_terminal_arbiter_property.py::test_total_order_pair[{case}]", "per_assertion_result_key": f"abstract_pair::{case}::canonical_receipt_equal", "required_result": "PASS"}})
    return result


EPOCH_ID = "00000000-0000-0000-0000-000000000401"
DISPOSITION_NONCE = "00000000-0000-0000-0000-000000000402"
WATCHDOG_OBSERVED_AT = "2026-07-13T00:00:05Z"


def _disposition(kind: str, mode: str, reason: str | None, causes: list[str], status: int) -> Json:
    return {"kind": kind, "mode": mode, "primary_reason": reason, "cleanup_causes": causes, "exit_status": status, "epoch_id": EPOCH_ID, "nonce": DISPOSITION_NONCE}


def _watchdog_receipt(verdict: str, child_status: int, backend_absent: bool | None, lock_absent: bool | None) -> Json:
    return {"epoch_id": EPOCH_ID, "nonce": DISPOSITION_NONCE, "verdict": verdict, "child_exit_status": child_status, "postgres_backend_absent": backend_absent, "advisory_lock_absent": lock_absent, "service_transition_writes": 0, "observed_at": WATCHDOG_OBSERVED_AT}


def cleanup_declarations() -> Json:
    return {
        "owners": {
            "service": "ServiceEpochCoordinator owns the final database commit, unlock, close and one process-local ExitDisposition; it performs zero service action after os._exit",
            "channel": "a pre-opened AF_UNIX SOCK_SEQPACKET pair carries exactly one typed ExitDisposition to CleanupExitWatchdog and one bounded ACK/NACK; it is not durable storage",
            "terminator": "ProcessTerminator invokes os._exit only for nonzero cleanup disposition or handoff failure and never runs service callbacks afterward",
            "external": "CleanupExitWatchdog owns child-exit wait, PostgreSQL backend/lock absence probes and its separate atomic JSON receipt; it never writes a service transition",
        },
        "last_database_commit": {"state": {"kind": "Stopping", "mode": "clean", "cleanup": "pending"}, "owner": "ServiceEpochCoordinator", "order": "commit before advisory unlock and connection close", "post_close_database_writes": 0},
        "process_local_exit_disposition": {"fields": {"kind": "Stopped|Terminating", "mode": "clean|clean_cleanup_failed", "primary_reason": "string|null", "cleanup_causes": "ordered string[]", "exit_status": "nonnegative integer", "epoch_id": "canonical UUID", "nonce": "canonical UUID"}, "serialization": "canonical UTF-8 JSON in one <=4096-byte SOCK_SEQPACKET frame with no secret fields", "channel_created_before_database_open": True, "ack_deadline_seconds": 2, "send_timeout_or_NACK_or_ack_timeout_exit": 75, "durability_claimed": False},
        "external_watchdog_receipt": {"fields": {"epoch_id": "canonical UUID", "nonce": "canonical UUID", "verdict": "closed enum", "child_exit_status": "nonnegative integer", "postgres_backend_absent": "boolean|null only for observation_timeout", "advisory_lock_absent": "boolean|null only for observation_timeout", "service_transition_writes": "literal zero", "observed_at": "UTC RFC3339 Z"}, "path_owner": "CleanupExitWatchdog fixed root-owned state directory", "commit": "same-directory mode-0600 temp, file fsync, atomic replace, parent-directory fsync", "readback": "fresh reopen, strict exact-field schema parse, epoch/nonce equality and SHA-256 receipt-byte equality", "observation_timeout_exit": 77, "write_fsync_readback_failure_or_timeout_exit": 76, "missing_or_rejected_disposition_exit": 78, "secret_fields": 0, "service_transition_writes": 0},
        "cleanup_matrix_formula": {"unlock_outcomes": ["true", "false", "exception"], "close_outcomes": ["success", "exception"], "late_fatal_variants": ["none", "one exact post-close/pre-disposition checkpoint selected by close outcome"], "case_count": 12, "row_generation_order": "unlock outer, close middle, late false then true; complete rows generated without reading candidates"},
        "handoff_failure_formula": {"cases": ["handoff_send_timeout", "handoff_nack", "handoff_ack_timeout", "watchdog_observation_timeout", "watchdog_receipt_write_failure", "watchdog_receipt_write_timeout", "watchdog_receipt_fsync_failure", "watchdog_receipt_readback_failure"], "case_count": 8, "deterministic_exit_owners": {"service_handoff": 75, "watchdog_receipt": 76, "watchdog_observation": 77, "watchdog_missing_disposition": 78}},
        "success_order": ["database commit Stopping(clean,cleanup_pending)", "unlock", "close", "process-local Stopped disposition", "bounded disposition ACK", "child exit 0", "watchdog backend/lock absence", "watchdog atomic receipt and readback"],
        "close_exception_order": ["database commit Stopping(clean,cleanup_pending)", "unlock", "close exception", "process-local Terminating disposition", "bounded disposition ACK", "os._exit(nonzero)", "watchdog child/backend/lock observations", "watchdog atomic receipt and readback"],
        "late_fatal_rule": "only after the exact close result and before disposition; deterministically changes the process-local result to Terminating(late_fatal,79), is handed off once, and causes os._exit(79) with no post-close database write",
        "forbidden": ["database write after close begins", "durable claim for child process memory", "service action after os._exit", "watchdog-authored service transition", "unacknowledged disposition treated as success", "receipt success claimed after write/fsync/readback failure"],
    }


def cleanup_rows() -> list[Json]:
    rows: list[Json] = []
    for unlock in ("true", "false", "exception"):
        for close in ("success", "exception"):
            late_values = ("none", "after_close_result_before_process_local_disposition") if close == "success" else ("none", "after_close_exception_before_process_local_disposition")
            for late in late_values:
                causes = (["unlock_false"] if unlock == "false" else ["unlock_exception"] if unlock == "exception" else []) + (["close_exception"] if close == "exception" else [])
                if late != "none":
                    reason, exit_status, verdict = "late_fatal", 79, "late_fatal"
                    causes.append("late_fatal")
                elif close == "exception":
                    reason, exit_status, verdict = "close_exception", 74, "cleanup_failed"
                elif unlock == "exception":
                    reason, exit_status, verdict = "unlock_exception", 73, "cleanup_failed"
                elif unlock == "false":
                    reason, exit_status, verdict = "unlock_false", 72, "cleanup_failed"
                else:
                    reason, exit_status, verdict = None, 0, "clean"
                clean = exit_status == 0
                disposition = _disposition("Stopped", "clean", None, [], 0) if clean else _disposition("Terminating", "clean_cleanup_failed", reason, causes, exit_status)
                case = f"unlock_{unlock}__close_{close}__late_{'none' if late == 'none' else late}"
                trace = ["db_commit:Stopping(clean,cleanup_pending)", "unlock_attempt", f"unlock_{unlock}", "close_attempt", f"close_{close}"]
                if late != "none":
                    trace.append(late)
                trace.extend([f"process_local:{disposition['kind']}", "disposition_send", "disposition_ack", "normal_return" if clean else f"os._exit({exit_status})", "watchdog:child_exit", "watchdog:backend_absent", "watchdog:lock_absent", "watchdog_receipt_atomic_commit", "watchdog_receipt_readback"])
                receipt = _watchdog_receipt(verdict, exit_status, True, True)
                rows.append({"case_key": case, "input": {"clean_intent": True, "unlock_outcome": unlock, "close_outcome": close, "late_fatal_checkpoint": late, "handoff_outcome": "ack", "watchdog_receipt_outcome": "success"}, "event_trace": trace, "expected": {"unlock_attempts": 1, "unlock_results": int(unlock != "exception"), "unlock_successes": int(unlock == "true"), "unlock_exceptions": int(unlock == "exception"), "connection_close_attempts": 1, "connection_close_results": int(close == "success"), "connection_close_successes": int(close == "success"), "connection_close_exceptions": int(close == "exception"), "database_terminal_commits_before_close": 1, "service_last_durable_database_state": {"kind": "Stopping", "mode": "clean", "cleanup": "pending"}, "post_close_database_writes": 0, "process_local_exit_disposition": disposition, "disposition_send_attempts": 1, "disposition_ack_successes": 1, "normal_returns": int(clean), "os_exit_attempts": int(not clean), "os_exit_nonzero": None if clean else exit_status, "external_watchdog_receipt": receipt, "watchdog_receipt_readback_successes": 1, "watchdog_exit_status": 0, "service_actions_after_os_exit": 0, "service_writes_after_os_exit": 0, "late_fatal_records": int(late != "none"), "concurrent_SQL": 0, "duplicate_unlock": 0}})
    return rows


def cleanup_failure_rows() -> list[Json]:
    specs = (
        ("handoff_send_timeout", "send_timeout", "not_attempted", 75, 78, "missing_disposition", True, True, True),
        ("handoff_nack", "nack", "not_attempted", 75, 78, "rejected_disposition", True, True, True),
        ("handoff_ack_timeout", "ack_timeout", "not_attempted", 75, 78, "ack_timeout", True, True, True),
        ("watchdog_observation_timeout", "ack", "observation_timeout", 0, 77, "observation_timeout", True, None, None),
        ("watchdog_receipt_write_failure", "ack", "write_failure", 0, 76, "receipt_write_failure", False, True, True),
        ("watchdog_receipt_write_timeout", "ack", "write_timeout", 0, 76, "receipt_write_timeout", False, True, True),
        ("watchdog_receipt_fsync_failure", "ack", "fsync_failure", 0, 76, "receipt_fsync_failure", False, True, True),
        ("watchdog_receipt_readback_failure", "ack", "readback_failure", 0, 76, "receipt_readback_failure", False, True, True),
    )
    rows: list[Json] = []
    for name, handoff, receipt_outcome, child_exit, watchdog_exit, verdict, durable, backend, lock in specs:
        disposition = _disposition("Terminating", "clean_cleanup_failed", "handoff_failure", [verdict], 75) if handoff != "ack" else _disposition("Stopped", "clean", None, [], 0)
        candidate = _watchdog_receipt(verdict, child_exit, backend, lock)
        rows.append({"case_key": name, "input": {"unlock_outcome": "true", "close_outcome": "success", "late_fatal_checkpoint": "none", "handoff_outcome": handoff, "watchdog_receipt_outcome": receipt_outcome}, "event_trace": ["db_commit:Stopping(clean,cleanup_pending)", "unlock_true", "close_success", f"process_local:{disposition['kind']}", f"handoff:{handoff}", f"watchdog:{receipt_outcome}", f"watchdog_exit:{watchdog_exit}"], "expected": {"service_last_durable_database_state": {"kind": "Stopping", "mode": "clean", "cleanup": "pending"}, "post_close_database_writes": 0, "process_local_exit_disposition": disposition, "child_exit_status": child_exit, "watchdog_exit_status": watchdog_exit, "watchdog_verdict": verdict, "watchdog_receipt_candidate": candidate, "external_watchdog_receipt": candidate if durable else None, "durable_external_receipt": durable, "watchdog_service_transition_writes": 0, "service_actions_after_os_exit": 0, "service_writes_after_os_exit": 0}})
    return rows


def cleanup_assertions() -> list[Json]:
    result: list[Json] = []
    all_rows = cleanup_rows() + cleanup_failure_rows()
    for index, row in enumerate(all_rows, 1):
        case = row["case_key"]
        result.append({"id": f"B04C{index:03d}", "class": "behavior", "input": row["input"], "interleaving": row["input"].get("late_fatal_checkpoint", row["input"].get("handoff_outcome")), "operation": {"source_entrypoint": "nvidia_build_lb.service_epoch:run_supervised_epoch_subprocess", "invoke_count": 1, "extraction": "child disposition channel, process exit, backend/lock probes and external receipt outcome"}, "expected": row["expected"], "owner": {"collected_node_id": f"tests/nvidia_routing/test_service_epoch_cleanup.py::test_post_clean_cleanup[{case}]", "per_assertion_result_key": f"cleanup::{case}::canonical_receipt_equal", "required_result": "PASS"}})
    return result


def projection_assertions() -> list[Json]:
    rows: list[Json] = []
    for index, (name, failures) in enumerate(PROJECTION_CASES, 1):
        rows.append({"id": f"B03P{index:03d}", "class": "projection", "input": {"fixture": name, "artifact": "contract-v15.json", "patch_source": "contract-v15-projection-receipt.json"}, "interleaving": "fresh bytes -> duplicate-key parse -> RFC6901 patch -> canonicalize -> independent validate", "operation": {"source_entrypoint": "verify-v15-contract.py:validate", "invoke_count": 1, "extraction": "ordered failure locations and mutated canonical SHA-256"}, "expected": {"failure_locations": list(failures)}, "owner": {"collected_node_id": f"tests/nvidia_routing/test_contract_projection.py::test_semantic_mutation[{name}]", "per_assertion_result_key": f"projection::{name}::ordered_failure_locations_equal", "required_result": "PASS"}})
    return rows


def generated_assertions(document: Json) -> list[Json]:
    return axis_rows(document) + release_assertions() + production_assertions() + abstract_assertions() + cleanup_assertions() + projection_assertions()


def validate(document: Json) -> list[str]:
    failures: list[str] = []
    if document.get("version") != "15.0":
        failures.append("/version")
    if document.get("schema_version") != 15:
        failures.append("/schema_version")
    selection = document.get("accepted_v12", {}).get("selection")
    actual_selection_sha = digest(selection)
    if actual_selection_sha != SELECTION_SHA256 or document.get("accepted_v12", {}).get("selection_sha256") != actual_selection_sha:
        failures.append("/accepted_v12/selection_sha256")
    if digest(document.get("accepted_v12")) != ACCEPTED_V12_SHA256:
        failures.append("/accepted_v12/predecessor_hashes")
    if digest(document.get("current_truth")) != CURRENT_TRUTH_SHA256:
        failures.append("/current_truth")
    predecessors = document.get("supersedes_rejected_predecessors")
    expected_predecessors = [{"artifact": "contract-v14.json", "sha256": V14_JSON_SHA256, "review": "CHANGES_REQUIRED", "review_json_sha256": V14_REVIEW_JSON_SHA256, "review_markdown_sha256": V14_REVIEW_MD_SHA256, "markdown_sha256": V14_MD_SHA256, "disposition": "retained accepted axes and replaced v14 B01-B03"}]
    if predecessors != expected_predecessors:
        failures.append("/supersedes_rejected_predecessors")
    if document.get("runtime_manifest", {}).get("sha256") != RUNTIME_MANIFEST_SHA256:
        failures.append("/runtime_manifest/sha256")
    if document.get("atomic_observable_contract", {}).get("driver_catalog") != driver_catalog():
        failures.append("/atomic_observable_contract/driver_catalog")
    expected_axis = axis_rows(document)
    catalog = document.get("atomic_observable_contract", {}).get("driver_catalog", {})
    for root in ROOT_ENTRYPOINTS:
        classes = {row["class"] for row in expected_axis if root_for(row["expected"]["canonical_result"]["unit_pointer"]) == root}
        derived = "mixed" if len(classes) == 2 else next(iter(classes))
        if catalog.get(root, {}).get("classification") != derived:
            if "/atomic_observable_contract/driver_catalog" not in failures:
                failures.append("/atomic_observable_contract/driver_catalog")
            break
    if document.get("accepted_axis_observables") != expected_axis:
        failures.append("/accepted_axis_observables")
    release = document.get("release_contract", {})
    declarations = release_declarations()
    if release.get("declarations") != declarations or any(release.get(key) != value for key, value in declarations.items()):
        failures.append("/release_contract/declarations")
    if release.get("boundary_injection_matrix") != release_rows():
        failures.append("/release_contract/boundary_injection_matrix")
    arbitration = document.get("arbitration_contract", {})
    expected_checkpoints = [{"checkpoint": checkpoint, "reachable": list(events), "exclusive_groups": [list(group) for group in exclusive]} for checkpoint, events, exclusive in CHECKPOINTS]
    if arbitration.get("priority") != list(PRIORITY) or arbitration.get("checkpoint_domains") != expected_checkpoints:
        failures.append("/arbitration_contract/checkpoint_domains")
    if arbitration.get("production_pair_derivation", {}).get("reachable_pairs") != reachable_pairs():
        failures.append("/arbitration_contract/production_pair_derivation/reachable_pairs")
    if arbitration.get("production_real_coordinator_gate", {}).get("cases") != production_rows():
        failures.append("/arbitration_contract/production_real_coordinator_gate/cases")
    if arbitration.get("abstract_arbiter_property", {}).get("cases") != abstract_rows():
        failures.append("/arbitration_contract/abstract_arbiter_property/cases")
    cleanup = document.get("cleanup_contract", {})
    expected_cleanup = cleanup_declarations()
    if cleanup.get("declarations") != expected_cleanup or any(cleanup.get(key) != value for key, value in expected_cleanup.items()):
        failures.append("/cleanup_contract/declarations")
    if cleanup.get("outcome_matrix") != cleanup_rows():
        failures.append("/cleanup_contract/outcome_matrix")
    if cleanup.get("handoff_failure_matrix") != cleanup_failure_rows():
        failures.append("/cleanup_contract/handoff_failure_matrix")
    assertions = document.get("executable_assertions", [])
    if assertions != generated_assertions(document):
        failures.append("/executable_assertions")
    ids = [row.get("id") for row in assertions]
    nodes = [row.get("owner", {}).get("collected_node_id") for row in assertions]
    result_keys = [row.get("owner", {}).get("per_assertion_result_key") for row in assertions]
    if len(ids) != len(set(ids)) or len(nodes) != len(set(nodes)) or len(result_keys) != len(set(result_keys)):
        failures.append("/executable_assertions/uniqueness")
    for index, row in enumerate(document.get("accepted_axis_observables", [])):
        fixture_text = canonical(row.get("input", {}))
        if any(token in fixture_text for token in (b"scenario_contract", b'"observed"', b'"expected"')):
            failures.append(f"/accepted_axis_observables/{index}/input")
    return failures


def resolve(document: Any, pointer: str) -> Any:
    current = document
    if pointer == "":
        return current
    for token in pointer.lstrip("/").split("/"):
        token = token.replace("~1", "/").replace("~0", "~")
        current = current[int(token)] if isinstance(current, list) else current[token]
    return current


def apply_patch(document: Json, operations: list[Json]) -> Json:
    result = copy.deepcopy(document)
    for operation in operations:
        pointer = operation["path"]
        tokens = pointer.lstrip("/").split("/")
        parent_pointer = "/" + "/".join(tokens[:-1]) if len(tokens) > 1 else ""
        parent = resolve(result, parent_pointer)
        key = tokens[-1].replace("~1", "/").replace("~0", "~")
        if operation["op"] == "replace":
            if isinstance(parent, list):
                parent[int(key)] = operation["value"]
            else:
                parent[key] = operation["value"]
        elif operation["op"] == "remove":
            parent.pop(int(key)) if isinstance(parent, list) else parent.pop(key)
        else:
            raise ValueError(operation["op"])
    return result


def semantic_mutation_patches(document: Json) -> list[tuple[str, list[Json]]]:
    changed_selection = copy.deepcopy(document["accepted_v12"]["selection"])
    changed_selection[0]["value"]["body_before_start"] = True
    input_with_oracle = copy.deepcopy(document["accepted_axis_observables"][0]["input"])
    input_with_oracle["expected"] = False
    return [
        ("stale_version", [{"op": "replace", "path": "/version", "value": "14.0"}]),
        ("coherent_selection_change", [{"op": "replace", "path": "/accepted_v12/selection", "value": changed_selection}, {"op": "replace", "path": "/accepted_v12/selection_sha256", "value": digest(changed_selection)}]),
        ("axis_input_oracle_added", [{"op": "replace", "path": "/accepted_axis_observables/0/input", "value": input_with_oracle}]),
        ("axis_entrypoint_changed", [{"op": "replace", "path": "/accepted_axis_observables/0/operation/source_entrypoint", "value": "tests.echo_fixture:echo"}]),
        ("axis_owner_changed", [{"op": "replace", "path": "/accepted_axis_observables/0/owner/collected_node_id", "value": "tests/wrong.py::test_wrong"}]),
        ("executable_oracle_changed", [{"op": "replace", "path": "/executable_assertions/0/expected/canonical_result/observed", "value": True}]),
        ("release_count_changed", [{"op": "replace", "path": "/release_contract/boundary_injection_matrix/0/expected/counts/ack_send", "value": 999}]),
        ("release_trace_changed", [{"op": "replace", "path": "/release_contract/boundary_injection_matrix/0/expected/finalization_trace/0", "value": "forged"}]),
        ("production_checkpoint_changed", [{"op": "replace", "path": "/arbitration_contract/production_real_coordinator_gate/cases/0/checkpoint", "value": "after_frame_send"}]),
        ("production_trace_changed", [{"op": "replace", "path": "/arbitration_contract/production_real_coordinator_gate/cases/0/event_trace/0", "value": "forged"}]),
        ("cleanup_trace_changed", [{"op": "replace", "path": "/cleanup_contract/outcome_matrix/0/event_trace/0", "value": "forged"}]),
        ("cleanup_state_changed", [{"op": "replace", "path": "/cleanup_contract/outcome_matrix/0/expected/process_local_exit_disposition/mode", "value": "failed"}]),
        ("cleanup_owner_changed", [{"op": "replace", "path": "/cleanup_contract/owners/external", "value": "service writes transitions after exit"}]),
        ("receipt_failure_exit_changed", [{"op": "replace", "path": "/cleanup_contract/handoff_failure_matrix/4/expected/watchdog_exit_status", "value": 0}]),
        ("release_dispatch_changed", [{"op": "replace", "path": "/release_contract/caught_cancellation_dispatch/dispatch_read", "value": "read outside lock"}]),
        ("checkpoint_declaration_changed", [{"op": "replace", "path": "/arbitration_contract/checkpoint_domains/0/checkpoint", "value": "after_frame_send"}]),
        ("last_database_state_changed", [{"op": "replace", "path": "/cleanup_contract/last_database_commit/state/kind", "value": "Stopped"}]),
        ("handoff_exit_changed", [{"op": "replace", "path": "/cleanup_contract/process_local_exit_disposition/send_timeout_or_NACK_or_ack_timeout_exit", "value": 0}]),
        ("receipt_readback_changed", [{"op": "replace", "path": "/cleanup_contract/external_watchdog_receipt/readback", "value": "trust in-memory candidate"}]),
        ("runtime_hash_changed", [{"op": "replace", "path": "/runtime_manifest/sha256", "value": "00" * 32}]),
        ("predecessor_hash_changed", [{"op": "replace", "path": "/supersedes_rejected_predecessors/0/sha256", "value": "00" * 32}]),
        ("missing_atomic_assertion", [{"op": "remove", "path": "/executable_assertions/0"}]),
    ]


def semantic_mutation_rows(document: Json) -> list[Json]:
    rows: list[Json] = []
    for name, patch in semantic_mutation_patches(document):
        mutated = apply_patch(document, patch)
        rows.append({"name": name, "patch": patch, "mutated_canonical_sha256": digest(mutated), "expected_failure_locations": validate(mutated)})
    return rows


def verifier_invocation(contract_path: Path, markdown_path: Path, receipt_path: Path) -> str:
    contract = contract_path.resolve()
    markdown = markdown_path.resolve()
    receipt = receipt_path.resolve()
    verifier = contract.parent / "verify-v15-contract.py"
    repository = contract.parents[3]
    return "cd " + shlex.quote(str(repository)) + " && uv run --no-sync python " + " ".join(shlex.quote(str(path)) for path in (verifier, contract, markdown, receipt))


def main() -> None:
    if len(sys.argv) != 4:
        raise SystemExit("usage: verify-v15-contract.py CONTRACT_JSON CONTRACT_MD RECEIPT_JSON")
    contract_path, markdown_path, receipt_path = (Path(value).resolve() for value in sys.argv[1:])
    raw = contract_path.read_bytes()
    document = json.loads(raw)
    receipt = json.loads(receipt_path.read_text())
    markdown = markdown_path.read_text()
    evidence_dir = contract_path.parent
    repository = contract_path.parents[3]
    fence_start, fence_end = "```contract-json\n", "\n```"
    if markdown.count(fence_start) != 1:
        raise SystemExit("markdown_fence_count")
    payload = markdown.split(fence_start, 1)[1].split(fence_end, 1)[0].encode() + b"\n"
    checks = {
        "raw_pretty_json_lf": raw == json.dumps(document, indent=2, ensure_ascii=False).encode() + b"\n",
        "markdown_payload_byte_exact": payload == raw,
        "canonical_sha256": digest(document),
        "pretty_bytes_sha256": hashlib.sha256(raw).hexdigest(),
        "baseline_failures": validate(document),
    }
    bound_files = {
        "contract-v14.json": V14_JSON_SHA256,
        "contract-v14.md": V14_MD_SHA256,
        "contract-v14-review.json": V14_REVIEW_JSON_SHA256,
        "contract-v14-review.md": V14_REVIEW_MD_SHA256,
        document["accepted_v12"]["artifact"]: document["accepted_v12"]["artifact_sha256"],
        "contract-v12.md": document["accepted_v12"]["markdown_sha256"],
        "contract-v12-review.json": document["accepted_v12"]["review_json_sha256"],
        "contract-v12-review.md": document["accepted_v12"]["review_markdown_sha256"],
        receipt["runtime_manifest_artifact"]: RUNTIME_MANIFEST_SHA256,
    }
    checks["bound_file_failures"] = [name for name, expected in bound_files.items() if not (evidence_dir / name).is_file() or file_sha256(evidence_dir / name) != expected]
    truth_paths = {
        "architecture_sha256": repository / "docs/ARCHITECTURE.md",
        "auth_sha256": repository / "src/nvidia_build_lb/auth.py",
        "db_models_sha256": repository / "src/nvidia_build_lb/db_models.py",
        "db_sha256": repository / "src/nvidia_build_lb/db.py",
        "main_sha256": repository / "src/nvidia_build_lb/main.py",
        "migration_0002_sha256": repository / "migrations/versions/0002_vault_auth.py",
        "plan_sha256": repository / ".omo/plans/nvidia-build-lb.md",
        "pyproject_sha256": repository / "pyproject.toml",
        "request_boundary_sha256": repository / "src/nvidia_build_lb/request_boundary.py",
        "scheduler_state_sha256": repository / "src/nvidia_build_lb/scheduler_state.py",
        "upstream_keys_sha256": repository / "src/nvidia_build_lb/upstream_keys.py",
        "uv_lock_sha256": repository / "uv.lock",
    }
    checks["current_truth_file_failures"] = [key for key, path in truth_paths.items() if not path.is_file() or file_sha256(path) != document["current_truth"][key]]
    checks["runtime_recomputation_failures"] = verify_runtime_bytes(evidence_dir / receipt["runtime_manifest_artifact"])
    expected_mutations = semantic_mutation_rows(document)
    expected_recomputation = {"baseline_failures": [], "mutation_count": len(expected_mutations), "result": "PASS"}
    checks["receipt_contract_failures"] = []
    if receipt.get("semantic_mutations") != expected_mutations:
        checks["receipt_contract_failures"].append("semantic_mutations")
    if receipt.get("recorded_recomputation") != expected_recomputation:
        checks["receipt_contract_failures"].append("recorded_recomputation")
    if receipt.get("verifier", {}).get("invocation") != verifier_invocation(contract_path, markdown_path, receipt_path):
        checks["receipt_contract_failures"].append("verifier.invocation")
    if not checks["raw_pretty_json_lf"] or not checks["markdown_payload_byte_exact"] or checks["baseline_failures"] or checks["bound_file_failures"] or checks["current_truth_file_failures"] or checks["runtime_recomputation_failures"] or checks["receipt_contract_failures"]:
        raise SystemExit(json.dumps(checks, sort_keys=True))
    if checks["canonical_sha256"] != receipt["input_canonical_sha256"] or checks["pretty_bytes_sha256"] != receipt["contract_pretty_bytes_sha256"]:
        raise SystemExit("receipt_hash_mismatch")
    observed: list[Json] = []
    for fixture in expected_mutations:
        mutated = apply_patch(document, fixture["patch"])
        row = {"name": fixture["name"], "mutated_canonical_sha256": digest(mutated), "failure_locations": validate(mutated)}
        observed.append(row)
        if row["mutated_canonical_sha256"] != fixture["mutated_canonical_sha256"] or row["failure_locations"] != fixture["expected_failure_locations"]:
            raise SystemExit(json.dumps(row, sort_keys=True))
    print(json.dumps({"result": "PASS", "checks": checks, "mutations": observed}, sort_keys=True))


if __name__ == "__main__":
    main()
