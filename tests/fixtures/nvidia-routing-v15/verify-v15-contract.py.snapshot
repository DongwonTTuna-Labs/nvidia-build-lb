    names = {
        "/asgi_sequence": "test_asgi_sequence.py",
        "/client_transport": "test_transport_contract.py",
        "/cookie_contract": "test_cookie_contract.py",
        "/header_validation": "test_header_validation.py",
        "/hook_order": "test_transport_guard.py",
        "/json_contract": "test_json_contract.py",
        "/persistence_schema": "test_persistence_schema.py",
        "/pinned_source": "test_pinned_runtime.py",
        "/poll_json_sse": "test_poll_representations.py",
        "/poll_scope": "test_poll_deadline.py",
        "/provider_probe_routing": "test_routing_coordinator.py",
        "/public_outcome_mapping": "test_outcome_mapping.py",
        "/repository_contract": "test_attempt_repository.py",
        "/request_wire_contract": "test_request_wire.py",
        "/response_consumption": "test_response_consumption.py",
        "/response_sanitization_and_logging": "test_response_sanitization.py",
        "/sse_contract": "test_sse_parser.py",
        "/terminal_contract": "test_terminal_contract.py",
        "/transport_exposed_equivalences": "test_transport_guard.py",
        "/terminal_arbiter/event_union": "test_terminal_observation.py",
        "/terminal_arbiter/same_discriminator_rule": "test_terminal_arbiter_property.py",
        "/terminal_arbiter/payload_creator": "test_terminal_arbiter_property.py",
        "/terminal_arbiter/losing_CAS": "test_terminal_arbiter_property.py",
        "/service_epoch/connection": "test_service_epoch_connection.py",
