def _dependencies(root: str) -> Json:
    network_roots = {"/client_transport", "/poll_json_sse", "/poll_scope", "/provider_probe_routing", "/request_wire_contract", "/response_consumption", "/response_sanitization_and_logging", "/sse_contract"}
    database_roots = {"/persistence_schema", "/repository_contract", "/provider_probe_routing", "/service_epoch/connection", "/service_epoch/advisory_lock", "/service_epoch/epoch", "/service_epoch/monitor", "/service_epoch/startup_order"}
    return {"clock": "ManualClock with the exact stimulus timeline", "transport": "ScriptedNoRetryTransport with exact request ledger" if root in network_roots else None, "database": "isolated PostgreSQL 17 transaction ledger" if root in database_roots else None, "send_recorder": "zero-buffer ASGI event recorder" if root in {"/asgi_sequence", "/terminal_contract"} else None}


def _hooks(root: str) -> list[str]:
    if root.startswith("/service_epoch/"):
        return ["before_database_commit", "after_database_commit", "before_close", "after_close"]
    if root in {"/terminal_contract", "/terminal_arbiter/same_discriminator_rule", "/terminal_arbiter/payload_creator", "/terminal_arbiter/losing_CAS"}:
        return ["before_register", "after_register", "before_persist", "after_persist"]
    if root in {"/poll_json_sse", "/poll_scope", "/provider_probe_routing"}:
        return ["before_origin_send", "after_origin_headers", "before_poll_or_alternate", "after_terminal"]
    return ["before_source_call", "after_source_call", "before_typed_receipt"]


def _extraction(root: str, pointer: str) -> str:
    sources = {
        "/asgi_sequence": "read the zero-buffer ASGI send recorder and terminal persistence ledger",
        "/client_transport": "read constructor-safe transport configuration, ScriptedPool request/close ledger and returned response-stream ledger",
        "/cookie_contract": "read RejectAllCookies/RejectAllCookieJar access counters and final empty-jar state",
        "/header_validation": "read HeaderValidationReceipt containing raw-parse decisions and typed header values",
        "/hook_order": "read the ordered request/private-send/response-hook boundary recorder",
        "/json_contract": "read BoundedJsonReceipt containing byte count, EOF state, parsed value and type validation",
        "/persistence_schema": "read PostgreSQL catalog rows after the exact upgrade/downgrade/reupgrade sequence",
        "/pinned_source": "read RuntimeGuardReceipt produced from fresh distribution bytes and module/logger identities",
        "/poll_json_sse": "read PollResultReceipt plus ScriptedNoRetryTransport request/body-close ledger",
        "/poll_scope": "read ManualClock wait ledger, absolute deadline receipt and reserved-key request ledger",
        "/provider_probe_routing": "read RoutingReceipt plus committed scheduler/event rows from isolated PostgreSQL",
        "/public_outcome_mapping": "read PublicOutcome returned for the concrete source_signal",
        "/repository_contract": "read command result plus exact committed receipt/event/pin rows from isolated PostgreSQL",
        "/request_wire_contract": "read immutable PreparedNvidiaRequest and transport request ledger before any response",
        "/response_consumption": "read BoundedResponseReceipt and iterator advance/close counters",
        "/response_sanitization_and_logging": "read SanitizedResponseReceipt and sentinel/logger access counters without reading sensitive values",
        "/sse_contract": "read SSEParserReceipt and emitted complete-frame byte ledger",
        "/terminal_contract": "read TerminalReceipt, persistence ledger, ASGI terminal-send ledger and owned-resource count",
        "/transport_exposed_equivalences": "read normalized HeaderReceipt while separately checking raw field-name casing",
        "/terminal_arbiter/same_discriminator_rule": "read immutable TerminalArbiter winner and record-only loser receipt",
        "/terminal_arbiter/payload_creator": "read payload-owner identity and immutable winner payload digest",
        "/terminal_arbiter/losing_CAS": "read late registration reason and zero side-effect ledger",
        "/service_epoch/connection": "read dedicated asyncpg connection creation/autocommit/pool ledger",
        "/service_epoch/advisory_lock": "read exact advisory-lock query arguments, attempt count and typed boolean result",
        "/service_epoch/epoch": "read process-local epoch creation counter and UUID receipt",
        "/service_epoch/monitor": "read monitor query/clock/cancellation ledger and fatal submission receipt",
        "/service_epoch/startup_order": "read ordered startup phase journal and final ready state",
    }
    return f"{sources[root]}; select only {pointer} from that independently recorded typed observation"


def axis_rows(document: Json) -> list[Json]:
    rows: list[Json] = []
    for index, (pointer, observed) in enumerate(selection_units(document), 1):
        root = root_for(pointer)
        projection = pointer in PROJECTION_UNITS or ROOT_ENTRYPOINTS[root].startswith("projection:")
        klass = "projection" if projection else "behavior"
        key = case_key(pointer)
        if projection:
            input_record = {
                "projection_pointer": pointer,
                "source_artifact": "contract-v15.json",
                "predecessor_artifact_imports": 0,
            }
            operation: Any = {
                "source_entrypoint": "verify-v15-contract.py:selection_units",
                "invoke_count": 1,
                "extraction": f"resolve canonical selected value at {pointer}",
            }
            interleaving = "parse current v15 bytes -> resolve pointer -> compare canonical expected"
            node_module = "test_design_projection.py"
        else:
            input_record = {
                "stimulus": _stimulus(root, pointer),
                "injected_dependencies": _dependencies(root),
                "interleaving_hooks": _hooks(root),
                "expected_or_observed_fields_in_fixture": 0,
                "contract_artifact_imports": 0,
            }
            operation = {
                "source_entrypoint": ROOT_ENTRYPOINTS[root],
                "invoke_count": 1,
                "arguments": {"stimulus": "input.stimulus", "dependencies": "input.injected_dependencies", "checkpoint_hooks": "input.interleaving_hooks"},
                "extraction": _extraction(root, pointer),
                "source_runtime_only": True,
            }
            interleaving = " -> ".join(_hooks(root))
            node_module = driver_test_module(root)
        rows.append(
            {
                "id": f"B00A{index:03d}",
                "class": klass,
                "input": input_record,
                "interleaving": interleaving,
                "operation": operation,
                "expected": {
                    "canonical_result": {
                        "unit_pointer": pointer,
                        "observed": observed,
                        "operation_attempts": 1,
                        "unsafe_side_effects": 0,
                    }
                },
                "owner": {
                    "collected_node_id": f"tests/nvidia_routing/{node_module}::test_atomic_accepted_axis[{key}]",
                    "per_assertion_result_key": f"accepted_axis::{key}::canonical_result_equal",
                    "required_result": "PASS",
                },
            }
        )
    return rows


