# syntax=docker/dockerfile:1.18
FROM node:22-bookworm@sha256:5647be709086c696ff32edaaf1c70cd26d1da6ab2b39c32f3c7b4c4a31957e37 AS admin
WORKDIR /src
COPY apps/admin/package.json apps/admin/package-lock.json ./apps/admin/
RUN npm ci --prefix apps/admin --ignore-scripts --no-audit --no-fund
COPY apps/admin ./apps/admin
RUN npm --prefix apps/admin run build

FROM rust:1.96-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY migrations/sqlx ./migrations/sqlx
RUN cargo build --locked --release -p nvidia-build-lb-gateway

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
RUN apt-get update \
    && apt-get install --no-install-recommends --yes util-linux ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin nblb \
    && install -d -o 65532 -g 65532 -m 0755 /var/lib/nvidia-build-lb /app
COPY --from=build /src/target/release/nvidia-build-lb-gateway /usr/local/bin/nvidia-build-lb-gateway
COPY --from=build /src/target/release/nblb-pg-bootstrap /usr/local/bin/nblb-pg-bootstrap
COPY --from=build /src/target/release/nblb-migrate /usr/local/bin/nblb-migrate
COPY migrations/sqlx /app/migrations/sqlx
COPY --from=admin /src/apps/admin/build /app/static
COPY docker/rust-entrypoint.sh /usr/local/bin/rust-entrypoint
COPY docker/rust-healthcheck.sh /usr/local/bin/rust-healthcheck
RUN chmod 0555 /usr/local/bin/rust-entrypoint /usr/local/bin/rust-healthcheck
WORKDIR /app
ENV NVIDIA_BUILD_LB_PUBLIC_PORT=2456 NVIDIA_BUILD_LB_STAGE=production
EXPOSE 2456
ENTRYPOINT ["/usr/local/bin/rust-entrypoint"]
HEALTHCHECK --interval=2s --timeout=2s --retries=20 CMD ["/usr/local/bin/rust-healthcheck"]
