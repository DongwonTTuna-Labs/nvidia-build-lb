# syntax=docker/dockerfile:1.18
FROM oven/bun:1.3.14@sha256:50317d83cd5a5ae1d8b35b3379c69f57ce1a0dbf4def91f0965653d767851834 AS admin
WORKDIR /src
COPY apps/admin/package.json apps/admin/bun.lock ./apps/admin/
RUN bun install --cwd apps/admin --frozen-lockfile --ignore-scripts --no-progress
COPY apps/admin ./apps/admin
RUN bun run --cwd apps/admin build

FROM oven/bun:1.3.14@sha256:50317d83cd5a5ae1d8b35b3379c69f57ce1a0dbf4def91f0965653d767851834 AS public-dashboard
WORKDIR /src
COPY apps/public/package.json apps/public/bun.lock ./apps/public/
RUN bun install --cwd apps/public --frozen-lockfile --ignore-scripts --no-progress
COPY apps/public ./apps/public
RUN bun run --cwd apps/public build

FROM rust:1.96-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY migrations/sqlx ./migrations/sqlx
RUN --mount=type=cache,id=nblb-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=nblb-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=nblb-cargo-target,target=/src/target,sharing=locked \
    cargo build --locked --release -p nvidia-build-lb-gateway --bins \
    && install -d /out \
    && install -m 0755 \
        target/release/nvidia-build-lb-gateway \
        target/release/nblb-pg-bootstrap \
        target/release/nblb-migrate \
        target/release/nblb-prestart \
        target/release/nblb-healthcheck \
        /out/

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
RUN apt-get update \
    && apt-get install --no-install-recommends --yes util-linux ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin nblb \
    && install -d -o 65532 -g 65532 -m 0755 /var/lib/nvidia-build-lb /app
COPY --from=build /out/nvidia-build-lb-gateway /usr/local/bin/nvidia-build-lb-gateway
COPY --from=build /out/nblb-pg-bootstrap /usr/local/bin/nblb-pg-bootstrap
COPY --from=build /out/nblb-migrate /usr/local/bin/nblb-migrate
COPY --from=build /out/nblb-prestart /usr/local/bin/nblb-prestart
COPY --from=build /out/nblb-healthcheck /usr/local/bin/nblb-healthcheck
COPY migrations/sqlx /app/migrations/sqlx
COPY --from=admin /src/apps/admin/build /app/static
COPY --from=public-dashboard /src/apps/public/build /app/public
RUN chmod 0555 /usr/local/bin/nblb-prestart /usr/local/bin/nblb-healthcheck
WORKDIR /app
ENV NVIDIA_BUILD_LB_PUBLIC_PORT=2456 NVIDIA_BUILD_LB_STAGE=production
EXPOSE 2456
ENTRYPOINT ["/usr/local/bin/nblb-prestart"]
HEALTHCHECK --interval=2s --timeout=2s --retries=20 CMD ["/usr/local/bin/nblb-healthcheck"]
