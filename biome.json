{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": [
      "apps/admin/**/*.ts",
      "apps/admin/**/*.svelte",
      "apps/admin/**/*.json",
      "apps/public/**/*.ts",
      "apps/public/**/*.svelte",
      "apps/public/**/*.json",
      "package.json",
      "biome.json",
      "knip.json",
      "!apps/admin/.svelte-kit",
      "!apps/admin/build",
      "!apps/public/.svelte-kit",
      "!apps/public/build",
      "!node_modules",
      "!.venv"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["apps/admin/**/*.svelte", "apps/public/**/*.svelte"],
      "linter": { "enabled": false }
    }
  ]
}
