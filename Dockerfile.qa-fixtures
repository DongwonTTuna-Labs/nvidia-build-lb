# syntax=docker/dockerfile:1.18
FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818
RUN apt-get update \
    && apt-get install --no-install-recommends --yes python3 curl util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin nblb \
    && install -d -o 65532 -g 65532 -m 0755 /run/nvidia-build-lb/qa-tls /qa
COPY scripts/qa/fake-entrypoint.sh /usr/local/bin/nblb-fake-entrypoint
COPY scripts/qa/loopback-entrypoint.sh /usr/local/bin/nblb-loopback-entrypoint
COPY scripts/qa/fake_nvidia_tls.py /qa/fake_nvidia_tls.py
COPY scripts/qa/loopback_proxy.py /qa/loopback_proxy.py
COPY docker/rust-healthcheck.sh /usr/local/bin/nblb-healthcheck
COPY docker/qa-healthcheck.sh /usr/local/bin/nblb-qa-healthcheck
COPY docker/fake-healthcheck.sh /usr/local/bin/nblb-fake-healthcheck
RUN chmod 0555 /usr/local/bin/nblb-fake-entrypoint /usr/local/bin/nblb-loopback-entrypoint /usr/local/bin/nblb-healthcheck /usr/local/bin/nblb-qa-healthcheck /usr/local/bin/nblb-fake-healthcheck
ENTRYPOINT ["/bin/sh"]
