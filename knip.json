{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["@sveltejs/adapter-static"],
  "ignoreFiles": [
    "**/src/lib/copy.ts",
    "**/src/routes/**",
    "**/svelte.config.ts"
  ],
  "workspaces": {
    "apps/admin": {
      "entry": ["svelte.config.ts", "vite.config.ts", "src/routes/**/*.svelte", "src/routes/**/*.ts"],
      "project": ["src/**/*.{ts,svelte}", "*.config.ts"]
    }
  }
}
