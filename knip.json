{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreDependencies": ["@sveltejs/adapter-static"],
  "ignoreFiles": [
    "**/src/lib/copy.ts",
    "**/svelte.config.ts"
  ],
  "workspaces": {
    ".": {
      "sveltekit": "svelte.config.ts",
      "entry": [
        "svelte.config.ts",
        "vite.config.ts",
        "src/routes/**/*.svelte",
        "src/routes/**/*.ts",
        "src/lib/**/*.svelte",
        "src/lib/**/*.ts"
      ],
      "project": ["src/**/*.{ts,svelte}", "*.config.ts"]
    }
  }
}
