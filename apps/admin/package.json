{
  "name": "@nvidia-build-lb/admin",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome check ../../apps/admin",
    "knip": "knip --config ../../knip.json --no-config-hints"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "knip": "5.88.1",
    "vite": "^7.1.2"
  }
}
